# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_db_password

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET_KEY=replace-with-a-random-secret-key-at-least-32-characters-long
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Services
USER_SERVICE_URL=http://localhost:8001
CATALOG_SERVICE_URL=http://localhost:8002
BOOKING_SERVICE_URL=http://localhost:8003
PAYMENT_SERVICE_URL=http://localhost:8004

# Payment
PAYMENT_WEBHOOK_SECRET=replace-with-a-secure-webhook-secret

# Booking
SEAT_LOCK_TTL_SECONDS=300
MAX_SEATS_PER_BOOKING=10

# Internal service mesh auth (shared secret between services, not real mTLS)
INTERNAL_SHARED_SECRET=replace-with-a-secure-internal-secret
